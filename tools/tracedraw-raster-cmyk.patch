index 0000000..e6a62b7
--- /dev/null
+++ b/crates/io/tests/bitmap_cmyk.rs
@@ -0,0 +1,148 @@
+use tracedraw_core::{
+    document::{PrimaryColorMode, Shape, ShapeKind},
+    geometry::{Rect, Size},
+    Color, Command, Document, Engine,
+};
+
+fn fixture() -> (Engine, tracedraw_core::ShapeId) {
+    let mut pixmap = tiny_skia::Pixmap::new(3, 1).unwrap();
+    pixmap.pixels_mut()[0] = tiny_skia::PremultipliedColorU8::from_rgba(255, 0, 0, 255).unwrap();
+    pixmap.pixels_mut()[1] = tiny_skia::PremultipliedColorU8::from_rgba(0, 0, 0, 128).unwrap();
+    let mut doc = Document::new("Raster color regression", Size::new(60.0, 35.0));
+    let layer = doc.pages[0].layers[0].id;
+    let id = doc.ids_mut().shape();
+    let shape = Shape::new(
+        id,
+        ShapeKind::Bitmap {
+            rect: Rect::new(4.0, 5.0, 34.0, 15.0),
+            width_px: 3,
+            height_px: 1,
+            png: pixmap.encode_png().unwrap(),
+            fx: None,
+        },
+    );
+    let mut engine = Engine::new(doc);
+    engine.run(&Command::AddShape { layer, shape }).unwrap();
+    (engine, id)
+}
+
+fn images(doc: &Document) -> Vec<(String, Vec<u8>)> {
+    let bytes = tracedraw_io::pdf::document_to_pdf(doc);
+    let pdf = lopdf::Document::load_mem(&bytes).unwrap();
+    pdf.objects
+        .values()
+        .filter_map(|o| {
+            let stream = o.as_stream().ok()?;
+            if stream.dict.get(b"Subtype").ok()?.as_name().ok()? != b"Image" {
+                return None;
+            }
+            Some((
+                String::from_utf8_lossy(stream.dict.get(b"ColorSpace").unwrap().as_name().unwrap())
+                    .into_owned(),
+                stream.decompressed_content().unwrap(),
+            ))
+        })
+        .collect()
+}
+
+#[test]
+fn bitmap_cmyk_export_has_four_real_channels_and_unchanged_alpha() {
+    let (mut engine, id) = fixture();
+    let before = engine.document().find_shape(id).unwrap().kind.clone();
+    engine
+        .run(&Command::SetBitmapColorMode {
+            shapes: vec![id],
+            mode: PrimaryColorMode::Cmyk,
+        })
+        .unwrap();
+    let exported = images(engine.document());
+    let cmyk = &exported
+        .iter()
+        .find(|(cs, _)| cs == "DeviceCMYK")
+        .expect("CMYK image, not an RGB label")
+        .1;
+    assert_eq!(cmyk.len(), 3 * 4);
+    let Color::Cmyk { c, m, y, k } = Color::rgb8(255, 0, 0).convert_to("CMYK") else {
+        panic!("CMYK")
+    };
+    let quantize = |v: f32| (v.clamp(0.0, 1.0) * 255.0).round() as u8;
+    assert_eq!(
+        &cmyk[..4],
+        &[quantize(c), quantize(m), quantize(y), quantize(k)]
+    );
+    assert_eq!(
+        exported
+            .iter()
+            .find(|(cs, _)| cs == "DeviceGray")
+            .unwrap()
+            .1,
+        [255, 128, 0]
+    );
+    assert!(!exported.iter().any(|(cs, _)| cs == "DeviceRGB"));
+    assert_eq!(engine.document().find_shape(id).unwrap().kind, before);
+}
+
+#[test]
+fn bitmap_mode_survives_native_save_and_undo_redo_and_rgb_return() {
+    let (mut engine, id) = fixture();
+    engine
+        .run(&Command::SetBitmapColorMode {
+            shapes: vec![id],
+            mode: PrimaryColorMode::Cmyk,
+        })
+        .unwrap();
+    let json = engine.document().to_json().unwrap();
+    let restored = Document::from_json(&json).unwrap();
+    assert!(images(&restored).iter().any(|(cs, _)| cs == "DeviceCMYK"));
+    engine.undo().unwrap();
+    assert!(images(engine.document())
+        .iter()
+        .any(|(cs, _)| cs == "DeviceRGB"));
+    engine.redo().unwrap();
+    assert!(images(engine.document())
+        .iter()
+        .any(|(cs, _)| cs == "DeviceCMYK"));
+    engine
+        .run(&Command::SetBitmapColorMode {
+            shapes: vec![id],
+            mode: PrimaryColorMode::Rgb,
+        })
+        .unwrap();
+    assert!(images(engine.document())
+        .iter()
+        .any(|(cs, _)| cs == "DeviceRGB"));
+    assert!(!images(engine.document())
+        .iter()
+        .any(|(cs, _)| cs == "DeviceCMYK"));
+    let old = json
+        .lines()
+        .filter(|line| !line.contains("\"bitmap_color_mode\""))
+        .collect::<Vec<_>>()
+        .join("\n");
+    let legacy = Document::from_json(&old).unwrap();
+    assert_eq!(legacy.find_shape(id).unwrap().bitmap_color_mode, None);
+}
+
+#[test]
+fn bitmap_conversion_does_not_convert_unselected_rgb_objects() {
+    let (mut engine, id) = fixture();
+    let doc = engine.document();
+    let layer = doc.pages[0].layers[0].id;
+    let mut other = doc.find_shape(id).unwrap().clone();
+    other.id = engine.new_shape_id();
+    engine
+        .run(&Command::AddShape {
+            layer,
+            shape: other,
+        })
+        .unwrap();
+    engine
+        .run(&Command::SetBitmapColorMode {
+            shapes: vec![id],
+            mode: PrimaryColorMode::Cmyk,
+        })
+        .unwrap();
+    let exported = images(engine.document());
+    assert!(exported.iter().any(|(cs, _)| cs == "DeviceCMYK"));
+    assert!(exported.iter().any(|(cs, _)| cs == "DeviceRGB"));
+}
