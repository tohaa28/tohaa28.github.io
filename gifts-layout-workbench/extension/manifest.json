{
  "manifest_version": 3,
  "name": "Макетная gifts.ru Bridge",
  "version": "1.0.0",
  "description": "Локальный мост между Макетной на GitHub Pages и авторизованным gifts.ru.",
  "permissions": ["tabs", "scripting"],
  "host_permissions": [
    "https://gifts.ru/*",
    "https://files.gifts.ru/*",
    "https://tohaa28.github.io/gifts-layout-workbench/*"
  ],
  "background": {
    "scripts": ["background.js"],
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://tohaa28.github.io/gifts-layout-workbench/*"],
      "js": ["bridge-content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Макетная gifts.ru"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "gifts-workbench-bridge@tohaa28.github.io",
      "strict_min_version": "121.0"
    }
  }
}