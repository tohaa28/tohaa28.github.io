{
  "manifest_version": 3,
  "name": "Vision Check — тестовая сеть (локальный адаптер)",
  "version": "0.1.13",
  "description": "Vision: из списка заказов читает согласования 2+, сообщения, проблемы и вложения в локальные ZIP-партии по 100 утверждённых заказов с папками заказов, обсуждений и файлов. Только тестовая сеть.",
  "host_permissions": [
    "http://psk.testgifts.local/*",
    "http://testgifts.local/*",
    "http://files.testgifts.local/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://psk.testgifts.local/devorders*"
      ],
      "js": [
        "content-transport.js",
        "vision-order-overlay.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "http://testgifts.local/private/order/*"
      ],
      "js": [
        "content-transport.js",
        "vision-order-approval.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "permissions": [
    "tabs",
    "downloads",
    "storage"
  ]
}
