{
  "manifest_version": 3,
  "name": "Vision Check — тестовая сеть (локальный адаптер)",
  "version": "0.1.4",
  "description": "Vision: автоматическое считывание выбранных проблем, обсуждений и вложенных макетов из согласований по артикулам. Только тестовая сеть, только локальный ZIP.",
  "host_permissions": [
    "http://psk.testgifts.local/*",
    "http://testgifts.local/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://psk.testgifts.local/devorders*"
      ],
      "js": [
        "content-transport.js",
        "vision-order-overlay.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "http://testgifts.local/private/order/*"
      ],
      "js": [
        "vision-order-approval.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
